#!/usr/bin/env python3
"""cwsweep-forward: relay cwsweep spots to a DX cluster, an HTTP endpoint or a file.

Reads "DX de ..." spot lines from cwsweep's telnet server (or stdin) and
forwards each one to any combination of:

  --cluster HOST:PORT   a DX-cluster node (DXSpider, AR-Cluster, CC Cluster),
                        posted with the node's "DX <freq> <call> <comment>" command
  --http URL            an HTTP endpoint (JSON POST per spot)
  --jsonl FILE          a JSON-lines log file

Connections are retried with back-off, so it can run unattended as a service.
Only the Python standard library is used.
"""

import argparse
import json
import os
import re
import select
import socket
import sys
import time
import urllib.request

SPOT_RE = re.compile(
    r"^DX de (?P<spotter>\S+?):?\s+(?P<freq>\d+\.\d)\s+(?P<call>\S+)\s+"
    r"(?P<comment>.*?)\s*(?P<time>\d{4})Z\s*$"
)


def log(msg):
    print(time.strftime("%Y-%m-%d %H:%M:%S"), msg, file=sys.stderr, flush=True)


def parse_hostport(s, default_port):
    host, _, port = s.rpartition(":")
    if not host:
        return s, default_port
    return host, int(port)


def parse_spot(line):
    m = SPOT_RE.match(line.strip())
    if not m:
        return None
    d = m.groupdict()
    spot = {
        "spotter": d["spotter"].rstrip(":"),
        "freq_khz": float(d["freq"]),
        "call": d["call"],
        "comment": " ".join(d["comment"].split()),
        "time": d["time"] + "Z",
        "raw": line.strip(),
    }
    m2 = re.search(r"(-?\d+)\s*dB\s+(\d+)\s*WPM\s*(\S*)", spot["comment"])
    if m2:
        spot["snr_db"] = int(m2.group(1))
        spot["wpm"] = int(m2.group(2))
        spot["kind"] = m2.group(3) or "DX"
    return spot


class LineConn:
    """A telnet-ish line connection with login handling and reconnection."""

    def __init__(self, name, host, port, login, password=None):
        self.name, self.host, self.port = name, host, port
        self.login, self.password = login, password
        self.sock = None
        self.buf = b""
        self.password_conf = password
        self.next_try = 0.0
        self.backoff = 2.0
        self.logged_in = False

    def ensure(self):
        if self.sock or time.time() < self.next_try:
            return self.sock is not None
        try:
            self.sock = socket.create_connection((self.host, self.port), timeout=10)
            self.sock.setblocking(False)
            self.buf = b""
            self.logged_in = False
            self.password = self.password_conf
            self.connected_at = time.time()
            self.backoff = 2.0
            log(f"{self.name}: connected to {self.host}:{self.port}")
        except OSError as e:
            log(f"{self.name}: cannot connect to {self.host}:{self.port}: {e}; retry in {self.backoff:.0f}s")
            self.next_try = time.time() + self.backoff
            self.backoff = min(self.backoff * 2, 120)
        return self.sock is not None

    def drop(self, why):
        log(f"{self.name}: disconnected ({why})")
        try:
            self.sock.close()
        except OSError:
            pass
        self.sock = None
        self.next_try = time.time() + self.backoff
        self.backoff = min(self.backoff * 2, 120)

    def send(self, text):
        if not self.sock:
            return False
        try:
            self.sock.sendall(text.encode() + b"\r\n")
            return True
        except OSError as e:
            self.drop(str(e))
            return False

    def read_lines(self):
        """Read available data; handle login prompts; return complete lines."""
        try:
            data = self.sock.recv(4096)
        except BlockingIOError:
            return []
        except OSError as e:
            self.drop(str(e))
            return []
        if not data:
            self.drop("closed by peer")
            return []
        # Strip telnet IAC negotiation sequences.
        data = re.sub(rb"\xff[\xfb-\xfe].|\xff[\xf0-\xfa]", b"", data)
        self.buf += data
        text = self.buf.decode(errors="replace").lower()
        if not self.logged_in and ("call" in text or "login" in text):
            self.send(self.login)
            self.logged_in = True
            self.buf = b""
            return []
        if self.logged_in and self.password and "password" in text:
            self.send(self.password)
            self.password = None  # send it once per connection attempt
            self.buf = b""
            return []
        *lines, self.buf = self.buf.split(b"\n")
        return [l.decode(errors="replace").rstrip("\r") for l in lines]

    def maybe_login_without_prompt(self):
        # Some nodes don't prompt; send the callsign after a short wait.
        if self.sock and not self.logged_in and time.time() - self.connected_at > 3:
            self.send(self.login)
            self.logged_in = True


def post_http(url, spot, timeout=10):
    req = urllib.request.Request(
        url, data=json.dumps(spot).encode(), headers={"Content-Type": "application/json"}, method="POST"
    )
    with urllib.request.urlopen(req, timeout=timeout) as r:
        r.read()


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    src = ap.add_mutually_exclusive_group()
    src.add_argument("--from", dest="source", default="localhost:7300",
                     help="cwsweep telnet server to read spots from (default localhost:7300)")
    src.add_argument("--stdin", action="store_true", help="read spot lines from stdin instead")
    ap.add_argument("--login", default="N0CALL", help="callsign used to log in to cwsweep and the cluster")
    ap.add_argument("--cluster", metavar="HOST:PORT", help="DX-cluster node to post spots to")
    ap.add_argument("--cluster-login", help="callsign for the cluster (default: --login)")
    ap.add_argument("--cluster-password", help="password, if the node asks for one")
    ap.add_argument("--min-interval", type=float, default=2.0,
                    help="minimum seconds between spots posted to the cluster (default 2)")
    ap.add_argument("--http", metavar="URL", help="POST each spot as JSON to this URL")
    ap.add_argument("--jsonl", metavar="FILE", help="append each spot as a JSON line to FILE")
    ap.add_argument("--only-cq", action="store_true", help="forward only stations calling CQ")
    ap.add_argument("--dry-run", action="store_true", help="print what would be sent to the cluster")
    args = ap.parse_args()

    if not (args.cluster or args.http or args.jsonl or args.dry_run):
        ap.error("nothing to do: give at least one of --cluster, --http, --jsonl, --dry-run")

    source = None
    if not args.stdin:
        h, p = parse_hostport(args.source, 7300)
        source = LineConn("cwsweep", h, p, args.login)
    cluster = None
    if args.cluster:
        h, p = parse_hostport(args.cluster, 7300)
        cluster = LineConn("cluster", h, p, args.cluster_login or args.login, args.cluster_password)
    queue = []
    last_post = 0.0

    def handle(line):
        spot = parse_spot(line)
        if not spot:
            return
        if args.only_cq and spot.get("kind") != "CQ":
            return
        log(f"spot {spot['call']} {spot['freq_khz']:.1f} {spot['comment']}")
        if args.jsonl:
            with open(args.jsonl, "a") as f:
                f.write(json.dumps(spot) + "\n")
        if args.http:
            try:
                post_http(args.http, spot)
            except Exception as e:  # never let a webhook failure stop the relay
                log(f"http: {e}")
        cmd = f"DX {spot['freq_khz']:.1f} {spot['call']} {spot['comment']}"[:80]
        if args.dry_run:
            print(cmd, flush=True)
        if cluster:
            queue.append(cmd)

    stdin_buf = b""
    stdin_eof = False
    while True:
        rlist = []
        if args.stdin and not stdin_eof:
            rlist.append(0)
        elif source and source.ensure():
            rlist.append(source.sock)
            source.maybe_login_without_prompt()
        if cluster and cluster.ensure():
            rlist.append(cluster.sock)
            cluster.maybe_login_without_prompt()

        ready = select.select(rlist, [], [], 0.5)[0] if rlist else (time.sleep(0.5) or [])
        for r in ready:
            if r == 0:
                data = os.read(0, 4096)
                if not data:
                    stdin_eof = True
                    if stdin_buf:
                        handle(stdin_buf.decode(errors="replace"))
                    continue
                stdin_buf += data
                *lines, stdin_buf = stdin_buf.split(b"\n")
                for line in lines:
                    handle(line.decode(errors="replace"))
            elif source and r is source.sock:
                for line in source.read_lines():
                    handle(line)
            elif cluster and r is cluster.sock:
                cluster.read_lines()  # node chatter: prompts, other users' spots

        if cluster and cluster.logged_in and queue and time.time() - last_post >= args.min_interval:
            if cluster.send(queue[0]):
                queue.pop(0)
                last_post = time.time()

        # Reading stdin: exit at end of input once everything has been posted.
        if stdin_eof and not (cluster and queue):
            return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(0)
