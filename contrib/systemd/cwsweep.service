# cwsweep as a system service (SDR via SoapySDR, a raw pipe, or a file).
# For sound-card input (PulseAudio/PipeWire) use user/cwsweep.service instead.
# Install: see docs/daemon.md
[Unit]
Description=cwsweep multi-channel CW decoder and spotter
Documentation=file:///usr/local/share/cwsweep/daemon.md
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/default/cwsweep
ExecStart=/usr/local/bin/cwsweep --no-color $CWSWEEP_ARGS
# cwsweep exits if its input fails (SDR unplugged, pipe closed): start it again.
Restart=always
RestartSec=5

User=cwsweep
Group=cwsweep
# Access to USB SDRs. The group name varies by distribution (plugdev on
# Debian/Ubuntu); uncomment and adjust, or install your SDR's udev rules.
#SupplementaryGroups=plugdev
StateDirectory=cwsweep
WorkingDirectory=/var/lib/cwsweep

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
