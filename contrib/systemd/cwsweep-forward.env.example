# cwsweep-forward settings: copy to /etc/default/cwsweep-forward and edit.
# See `cwsweep-forward --help`. At least one destination is required.

# Post spots to your own DX-cluster node, at most one every 2 s:
FORWARD_ARGS=--from localhost:7300 --login N0CALL --cluster dxc.example.org:7300 --min-interval 2

# Or/also: JSON to a web service, and a local JSON-lines log
#FORWARD_ARGS=--from localhost:7300 --login N0CALL --http https://example.org/api/spots --jsonl /var/lib/cwsweep/spots.jsonl
