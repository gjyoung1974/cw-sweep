# cwsweep service settings: copy to /etc/default/cwsweep (system service)
# or ~/.config/cwsweep/cwsweep.env (user service) and edit.
#
# Everything in CWSWEEP_ARGS is passed to cwsweep; see `cwsweep --help`.
# Keep --telnet so loggers and cwsweep-forward can collect the spots.
# --no-text keeps the journal to spots only; remove it to log decoded text too.

# SDR via SoapySDR, about +-90 kHz around 14.06 MHz:
CWSWEEP_ARGS=--call N0CALL --telnet 7300 --no-text --freq 14.06M --rate 192k soapy:driver=rtlsdr,direct_samp=2

# Radio audio from a sound card (user service only):
#CWSWEEP_ARGS=--call N0CALL --telnet 7300 --no-text --freq 14.025M pulse:alsa_input.usb-Burr-Brown_USB_Audio_CODEC-00.analog-stereo

# Optional: known-calls list for single-copy spotting
#CWSWEEP_ARGS=... --scp /var/lib/cwsweep/MASTER.SCP ...
